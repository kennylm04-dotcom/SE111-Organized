<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Pay Calculator</title>
  <style>
    :root {
      --bg: #0f111a;
      --surface: #1a1d2e;
      --accent: #7c6af7;
      --accent2: #50e3c2;
      --text: #e8eaf0;
      --muted: #8b8fa8;
      --border: #2a2d40;
      --radius: 12px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Courier New', monospace;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 2.5rem;
      width: 100%;
      max-width: 480px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    }

    h1 {
      font-size: 1.4rem;
      letter-spacing: 0.1em;
      color: var(--accent2);
      margin-bottom: 2rem;
      text-transform: uppercase;
    }

    label {
      display: block;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      color: var(--muted);
      text-transform: uppercase;
      margin-bottom: 0.4rem;
    }

    input {
      width: 100%;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      font-family: inherit;
      font-size: 1rem;
      padding: 0.65rem 1rem;
      margin-bottom: 1.25rem;
      transition: border-color 0.2s;
      outline: none;
    }

    input:focus { border-color: var(--accent); }

    .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

    button {
      width: 100%;
      padding: 0.8rem;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-family: inherit;
      font-size: 0.9rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      transition: opacity 0.2s, transform 0.1s;
      margin-top: 0.5rem;
    }
    button:active { transform: scale(0.98); }

    #enter-button {
      background: var(--accent);
      color: #fff;
      margin-bottom: 0.75rem;
    }

    #submit {
      background: transparent;
      color: var(--accent2);
      border: 1px solid var(--accent2);
    }

    button:hover { opacity: 0.85; }

    #check {
      margin-top: 1.5rem;
      background: rgba(80,227,194,0.07);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.2rem 1.4rem;
      font-size: 0.9rem;
      line-height: 1.9;
      color: var(--text);
      display: none;
    }

    #check span { color: var(--accent2); font-weight: bold; }

    #info {
      margin-top: 0.75rem;
      font-size: 0.85rem;
      color: var(--muted);
      text-align: center;
    }
  </style>
</head>
<body>
<div class="card">
  <h1>Pay Calculator</h1>

  <div class="row">
    <div>
      <label for="first">First Name</label>
      <input type="text" id="first" placeholder="Jane" />
    </div>
    <div>
      <label for="last">Last Name</label>
      <input type="text" id="last" placeholder="Doe" />
    </div>
  </div>

  <div class="row">
    <div>
      <label for="hours">Hours Worked</label>
      <input type="number" id="hours" placeholder="40" min="0" />
    </div>
    <div>
      <label for="rate">Hourly Rate ($)</label>
      <input type="number" id="rate" placeholder="25.00" min="0" step="0.01" />
    </div>
  </div>

  <button id="enter-button">Calculate Pay</button>
  <button id="submit">Show Alert Summary</button>

  <div id="check"></div>
  <div id="info"></div>
</div>

<script>
  document.querySelector('#enter-button').addEventListener('click', alertName);

  function alertName() {
    var fname  = document.querySelector('#first').value;
    var lname  = document.querySelector('#last').value;
    var hours  = document.querySelector('#hours').value;
    var rate   = document.querySelector('#rate').value;

    var full   = fname + ' ' + lname;
    hours      = Number(hours);
    rate       = Number(rate);

    var gross     = hours * rate;
    var taxAmount = gross * 0.2;
    var net       = gross - taxAmount;

    var finalMessage = `
      <b>${full}</b><br>
      Gross Pay: <span>$${gross.toFixed(2)}</span><br>
      Tax Amount (20%): <span>$${taxAmount.toFixed(2)}</span><br>
      Net Pay: <span>$${net.toFixed(2)}</span>
    `;

    var info = document.querySelector('#info');
    info.innerHTML = '';

    var num = document.querySelector('#check');
    num.style.display = 'block';
    num.innerHTML = `
      Gross Pay: <span>$${gross.toFixed(2)}</span><br>
      Tax Amount: <span>$${taxAmount.toFixed(2)}</span><br>
      Net Pay: <span>$${net.toFixed(2)}</span>
    `;
  }

  function submitNow(e) {
    var fname  = document.querySelector('#first').value;
    var lname  = document.querySelector('#last').value;
    var hours  = Number(document.querySelector('#hours').value);
    var rate   = Number(document.querySelector('#rate').value);

    var full      = fname + ' ' + lname;
    var gross     = hours * rate;
    var taxAmount = gross * 0.2;
    var net       = gross - taxAmount;

    alert(
      `${full}\n` +
      `HOURS: ${hours}\n` +
      `RATE: $${rate.toFixed(2)}\n` +
      `GROSS PAY: $${gross.toFixed(2)}\n` +
      `TAX AMOUNT: $${taxAmount.toFixed(2)}\n` +
      `NET PAY: $${net.toFixed(2)}`
    );
  }

  document.querySelector('#submit').addEventListener('click', submitNow);
</script>
</body>
</html>